{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "scan": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["GITHUB_TOKEN", "GITHUB_ORG", "OUTPUT_DIR", "DEPLOYER"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
